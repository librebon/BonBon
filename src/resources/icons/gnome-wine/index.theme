[Icon Theme]
Name=Libreworks GNOME-Wine
Comment=GNOME-Wine icons bundled for Libreworks (subset)
# No Inherits: the app must never fall through to the system theme in default mode
Example=document-open

Directories=16x16/actions,22x22/actions,24x24/actions,32x32/actions,scalable/actions

[16x16/actions]
Size=16
Context=Actions
Type=Fixed

[22x22/actions]
Size=22
Context=Actions
Type=Fixed

[24x24/actions]
Size=24
Context=Actions
Type=Fixed

[32x32/actions]
Size=32
Context=Actions
Type=Fixed

[scalable/actions]
Size=48
Context=Actions
Type=Scalable
MinSize=8
MaxSize=256
