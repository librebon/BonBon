# Branding: Libreworks (default) or Bonbon. Driven by -DLW_BRAND=Bonbon or -DBRAND=bonbon.
set(LW_BRAND "Libreworks" CACHE STRING "Product brand: Libreworks or Bonbon")
set_property(CACHE LW_BRAND PROPERTY STRINGS Libreworks Bonbon)
if(DEFINED BRAND AND NOT BRAND STREQUAL "")
  string(TOLOWER "${BRAND}" _brand_lc)
  if(_brand_lc STREQUAL "bonbon")
    set(LW_BRAND "Bonbon" CACHE STRING "Product brand: Libreworks or Bonbon" FORCE)
  elseif(_brand_lc STREQUAL "libreworks")
    set(LW_BRAND "Libreworks" CACHE STRING "Product brand: Libreworks or Bonbon" FORCE)
  else()
    message(FATAL_ERROR "Unknown BRAND='${BRAND}' (expected Libreworks or Bonbon)")
  endif()
endif()
string(TOLOWER "${LW_BRAND}" _lw_brand_lc)
if(_lw_brand_lc STREQUAL "bonbon")
  set(LW_PRODUCT_NAME "Bonbon")
  set(LW_PRODUCT_NAME_LOWER "bonbon")
  set(LW_ORG_NAME "Bonbon")
  set(LW_EXE_NAME "bonbon")
  # Reverse-DNS id for AppStream / Flatpak / desktop+icon install names.
  # Domain is lowercase; the last component is the GitHub repo name as-is
  # (Flathub code-hosting rule), so this is io.github.librebon.BonBon.
  set(LW_APP_ID "io.github.librebon.BonBon")
  set(LW_DESKTOP_ID "io.github.librebon.BonBon")
  set(LW_ICON_NAME "io.github.librebon.BonBon")
  set(LW_PACKAGE_NAME "bonbon")
  set(LW_DOC_DIR "bonbon")
  set(LW_LIB_DIR_NAME "bonbon")
  set(LW_IS_BONBON 1)
  set(LW_DOC_EXT "bon")
  set(LW_DOC_MIME "application/x-bonbon")
  set(LW_DOC_ICON_NAME "application-x-bonbon")
  set(LW_DOC_FILTER_NAME "Bonbon Document")
  set(LW_DESKTOP_MIME "application/x-bonbon;application/x-libreworks;image/png;image/apng;image/jpeg;image/webp;image/gif;image/avif;image/jxl;image/heic;image/heif;image/heic-sequence;image/heif-sequence;image/bmp;image/x-bmp;image/x-ms-bmp;image/tiff;image/x-tga;image/x-targa;image/vnd.adobe.photoshop;image/x-psd;application/x-photoshop;image/openraster;image/x-xcf;image/svg+xml;image/svg+xml-compressed;image/x-dcraw;image/x-adobe-dng;image/x-canon-cr2;image/x-canon-cr3;image/x-canon-crw;image/x-nikon-nef;image/x-nikon-nrw;image/x-sony-arw;image/x-sony-srf;image/x-sony-sr2;image/x-olympus-orf;image/x-panasonic-rw2;image/x-fuji-raf;image/x-pentax-pef;image/x-samsung-srw;image/x-sigma-x3f;image/x-kodak-dcr;image/x-kodak-kdc;image/x-minolta-mrw;image/x-epson-erf;image/x-hasselblad-3fr;image/x-exr;image/vnd.radiance;image/x-hdr;image/x-portable-floatmap;image/vnd.ms-dds;image/x-dds;image/ktx2;image/qoi;image/x-qoi;image/vnd.microsoft.icon;image/x-icon;image/x-win-bitmap;image/x-cursor;image/x-icns;image/x-portable-pixmap;image/x-portable-anymap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-arbitrarymap;image/vnd.zbrush.pcx;image/x-pcx;image/x-xpixmap;image/x-xbitmap;")
  set(LW_DOC_MIME_EXTRA [=[
  <mime-type type="application/x-libreworks">
    <comment>Libreworks document</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.lwd"/>
    <icon name="libreworks"/>
  </mime-type>]=])
  set(LW_ABOUT_TAGLINE "A native Linux image editor in the spirit of Macromedia Fireworks MX 2004, with modern formats.")
  set(LW_ABOUT_CREDIT "Bonbon is a re-branded build based on Libreworks.")
  set(LW_APPIMAGE_PREFIX "Bonbon")
elseif(_lw_brand_lc STREQUAL "libreworks")
