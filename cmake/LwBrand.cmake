  set(LW_DOC_MIME_EXTRA "")
  set(LW_ABOUT_TAGLINE "A native Linux image editor in the spirit of Macromedia Fireworks MX 2004, with modern formats.")
  set(LW_ABOUT_CREDIT "Libreworks is an independent project and is not affiliated with Adobe or Macromedia.")
  set(LW_APPIMAGE_PREFIX "Libreworks")
else()
  message(FATAL_ERROR "LW_BRAND must be Libreworks or Bonbon (got '${LW_BRAND}')")
endif()
